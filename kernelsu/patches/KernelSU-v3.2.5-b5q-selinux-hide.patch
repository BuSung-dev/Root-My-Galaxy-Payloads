+#ifdef KSU_SELINUX_HIDE_KPROBES
+/*
+ * Samsung RKP protects the SELinux operation tables. Use the kernel's own
+ * kprobe API, as the Samsung credential hooks do, without writing those tables.
+ * The pre-handler only redirects execution: policy parsing and allocations run
+ * after the breakpoint exception has returned, in the original task context.
+ */
+struct selinux_hide_probe {
+    struct kprobe probe;
+    const char *name;
+    void *replacement;
+};
+
+static bool samsung_hide_probes_ready;
+
+static int samsung_hide_pre(struct kprobe *probe, struct pt_regs *regs)
+{
+    struct selinux_hide_probe *hook = container_of(probe, struct selinux_hide_probe, probe);
+
+    if (!smp_load_acquire(&ksu_selinux_hide_enabled) || current_uid().val < 10000)
+        return 0;
+
+    /* my_setprocattr may call the original after validating the context. */
+    if (within_module(regs->regs[30], THIS_MODULE))
+        return 0;
+
+    instruction_pointer_set(regs, (unsigned long)hook->replacement);
+    return 1;
+}
+NOKPROBE_SYMBOL(samsung_hide_pre);
+
+static struct selinux_hide_probe samsung_hide_probes[] = {
+    { .name = "sel_write_context", .replacement = my_write_context },
+    { .name = "sel_write_access", .replacement = my_write_access },
+    { .name = "selinux_setprocattr", .replacement = my_setprocattr },
+    { .name = "sel_open_handle_status", .replacement = my_sel_open_handle_status },
+};
+
+static int samsung_hide_enable(void)
+{
+    int i, ret;
+
+    if (samsung_hide_probes_ready)
+        return 0;
+    if (!ksu_late_loaded)
+        return -EOPNOTSUPP;
+    if (!fake_status) {
+        pr_err("selinux_hide: no pre-KSU status snapshot; refusing partial activation\n");
+        return -EAGAIN;
+    }
+
+    /* Resolve entry addresses, not CFI jump-table aliases. */
+    for (i = 0; i < ARRAY_SIZE(samsung_hide_probes); i++) {
+        struct selinux_hide_probe *hook = &samsung_hide_probes[i];
+
+        hook->probe.addr = (kprobe_opcode_t *)find_kernel_symbol_exact(hook->name);
+        if (!hook->probe.addr) {
+            pr_err("selinux_hide: missing probe target %s\n", hook->name);
+            return -ENOENT;
+        }
+        hook->probe.pre_handler = samsung_hide_pre;
+    }
+
+    orig_context_write = (write_op_fn)samsung_hide_probes[0].probe.addr;
+    orig_access_write = (write_op_fn)samsung_hide_probes[1].probe.addr;
+    selinux_setprocattr_hook.original = samsung_hide_probes[2].probe.addr;
+    orig_sel_open_handle_status = (sel_open_handle_status_fn)samsung_hide_probes[3].probe.addr;
+
+    for (i = 0; i < ARRAY_SIZE(samsung_hide_probes); i++) {
+        ret = register_kprobe(&samsung_hide_probes[i].probe);
+        if (ret) {
+            pr_err("selinux_hide: probe %s failed: %d\n", samsung_hide_probes[i].name, ret);
+            while (i-- > 0)
+                unregister_kprobe(&samsung_hide_probes[i].probe);
+            return ret;
+        }
+    }
+
+    /*
+     * Redirected functions may sleep, and status mappings may outlive the
+     * feature toggle. Keep code, snapshots and probes for this boot. Disabling
+     * only stops new redirects; do not free state under in-flight callers.
+     */
+    __module_get(THIS_MODULE);
+    samsung_hide_probes_ready = true;
+    pr_info("selinux_hide: Samsung kprobe hooks ready (module pinned until reboot)\n");
+    return 0;
+}
+#endif
